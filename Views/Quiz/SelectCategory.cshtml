@{
    ViewData["Title"] = "Select Category";
}

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg">
        <div class="card-header bg-primary text-white text-center py-3">
          <h3 class="mb-0">&#x1F4CA; Choose Quiz Category</h3>
        </div>
        <div class="card-body p-5">

          <p class="text-muted text-center mb-4">Select a category to begin your 10-question quiz:</p>

          <div class="row g-3">
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category="SP"
                 class="btn btn-primary btn-lg w-100 py-3">
                <div style="font-size:1.5rem;">&#x1F4CA;</div>
                SOLID Principles
              </a>
            </div>
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category="OOP"
                 class="btn btn-info btn-lg w-100 py-3">
                <div style="font-size:1.5rem;">&#x1F308;</div>
                OOP
              </a>
            </div>
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category="DS"
                 class="btn btn-success btn-lg w-100 py-3">
                <div style="font-size:1.5rem;">&#x1F9F0;</div>
                Data Structures
              </a>
            </div>
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category=".NET"
                 class="btn btn-warning btn-lg w-100 py-3">
                <div style="font-size:1.5rem;">&#x26A1;</div>
                .NET Framework
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
          &#x2190; Back to Home
        </a>
      </div>
    </div>
  </div>
</div>
