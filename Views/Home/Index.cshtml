@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg">
        <div class="card-body text-center p-5">
          <div class="mb-3" style="font-size:4rem;">&#x1F9E0;</div>
          <h1 class="display-5 fw-bold text-primary mb-3">Category-Based Quiz</h1>
          <p class="lead text-muted mb-4">
            Test your knowledge across multiple categories.<br />
            10 random questions per quiz &mdash; score <span class="badge bg-success fs-6">90%+</span>
            to make the leaderboard!
          </p>

          <div class="d-flex justify-content-center gap-2 mb-4">
            <a asp-controller="Admin" asp-action="Winners" class="btn btn-outline-warning">
              &#x1F3C6; Leaderboard
            </a>
          </div>

          <hr class="my-4" />

          <h5 class="fw-bold mb-3">Choose a Category:</h5>

          <div class="row g-3">
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category="SP" 
                 class="btn btn-primary btn-lg w-100 py-4">
                <div style="font-size:2rem;">&#x1F4CA;</div>
                <strong>SOLID Principles</strong>
              </a>
            </div>
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category="OOP"
                 class="btn btn-info btn-lg w-100 py-4">
                <div style="font-size:2rem;">&#x1F308;</div>
                <strong>Object-Oriented</strong>
              </a>
            </div>
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category="DS"
                 class="btn btn-success btn-lg w-100 py-4">
                <div style="font-size:2rem;">&#x1F9F0;</div>
                <strong>Data Structures</strong>
              </a>
            </div>
            <div class="col-md-6">
              <a asp-controller="Quiz" asp-action="Register" asp-route-category=".NET"
                 class="btn btn-warning btn-lg w-100 py-4">
                <div style="font-size:2rem;">&#x26A1;</div>
                <strong>.NET Framework</strong>
              </a>
            </div>
          </div>

          <hr class="my-4" />

          <div class="row g-3 mt-2">
            <div class="col-4">
              <div class="p-3 bg-primary bg-opacity-10 rounded">
                <div class="fs-3 fw-bold text-primary">60</div>
                <small class="text-muted">SP</small>
              </div>
            </div>
            <div class="col-4">
              <div class="p-3 bg-info bg-opacity-10 rounded">
                <div class="fs-3 fw-bold text-info">60</div>
                <small class="text-muted">OOP</small>
              </div>
            </div>
            <div class="col-4">
              <div class="p-3 bg-success bg-opacity-10 rounded">
                <div class="fs-3 fw-bold text-success">60</div>
                <small class="text-muted">DS</small>
              </div>
            </div>
            <div class="col-12">
              <div class="p-3 bg-warning bg-opacity-10 rounded">
                <div class="fs-3 fw-bold text-warning">60</div>
                <small class="text-muted">.NET</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
